# Copy to .env (git-ignored): Copy-Item .env.example .env
# Everything here is a placeholder or a safe local demo default. Change the
# secrets for anything other than a throwaway local stack.

# --- Host ports (5173, 8000 and 5432 are used by another project on this machine)
POSTGRES_HOST_PORT=5433
ORCHESTRATOR_HOST_PORT=8100
FRONTEND_HOST_PORT=4200
# The strangler facade's BillRite business API (ADR-039).
FACADE_HOST_PORT=8200

# --- Database. Keep these URL-safe: they are interpolated into connection URLs.
POSTGRES_PASSWORD=local-owner-change-me
APP_DB_PASSWORD=local-app-change-me
# The API's least-privilege login. Created by db/init, granted by the migration (ADR-029).
APP_DB_ROLE=offshoot_app

# --- Application
APP_ENV=development
DEMO_MODE=true
# At least 32 characters. The app refuses placeholder values when APP_ENV=production.
JWT_SECRET=local-dev-only-change-me-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:4200
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Shared by the orchestrator and the two runners; every runner call carries it (ADR-013).
# At least 16 characters.
RUNNER_SHARED_SECRET=local-runner-change-me-1234
# Shared by the orchestrator and the facade for its internal API (ADR-039). At least 16 characters.
FACADE_SHARED_SECRET=local-facade-change-me-1234

# --- Published demo accounts: viewer, engineer, architect and admin, password demo1234,
# shown on the sign-in page (ADR-050). They are fixed in code, so nothing to set here.

# --- AI. Mock is the default product mode and needs no key and no network.
# To use Gemini: set AI_MODE=gemini, your own key, and a model. The free-tier model
# checked on 2026-11-04 was gemini-3.5-flash-lite. Check the current list before use.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=
# Each call waits at most this long. Each project may make at most this many live calls.
AI_TIMEOUT_SECONDS=60
AI_PROJECT_CALL_BUDGET=50

# --- Local run of the production image (compose.prod.yaml). Production refuses placeholder
# secrets, so set at least 32 random characters here, for example with:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
PROD_JWT_SECRET=
# Host port for the production image (the container listens on 8080).
PROD_HOST_PORT=8300
