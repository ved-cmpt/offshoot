     "        var energy = RoundToCent((tier1Kwh * tariff.Tier1Rate) + (tier2Kwh * tariff.Tier2Rate));",
     "",
     "        var subtotal = energy + tariff.ServiceCharge;",
     "        var minimumApplied = subtotal < tariff.MinimumCharge;",
     "        if (minimumApplied)",
     "        {",
     "            subtotal = tariff.MinimumCharge;",
     "        }",
