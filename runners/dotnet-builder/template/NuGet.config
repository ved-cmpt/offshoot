<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org is reachable only while the image builds. At run time the builder has no
       network, and restore resolves everything from the offline package folder. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
